# Caddy mengurus sertifikat HTTPS (Let's Encrypt) otomatis untuk domain di bawah.
# APP_DOMAIN dan API_DOMAIN diisi dari deploy/.env lewat docker-compose.

{$APP_DOMAIN} {
	root * /srv/app
	encode gzip zstd
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
	}
	# Aset berhash boleh di-cache lama; index.html tidak.
	@assets path /assets/* /fonts/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html
	header @html Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}

{$API_DOMAIN} {
	encode gzip zstd
	header {
		X-Content-Type-Options nosniff
		Strict-Transport-Security "max-age=31536000"
	}
	# 6 MB: bukti transfer maks. 5 MB + isian form (batas yang sama diterapkan lagi oleh API).
	request_body {
		max_size 6MB
	}
	# Caddy menimpa X-Forwarded-For dengan IP klien sebenarnya; API memercayainya (TRUSTED_PROXIES).
	reverse_proxy api:8080
}

# Convera Admin (internal tim): UI statis + API admin di origin yang sama (cookie sesi SameSite=Strict, tanpa CORS).
# Batasi ke IP kantor/VPN dengan ADMIN_ALLOW_IPS di deploy/.env (default: semua IP, sesi + CSRF tetap berlaku).
{$ADMIN_DOMAIN} {
	encode gzip zstd
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
	}
	@blocked not remote_ip {$ADMIN_ALLOW_IPS}
	respond @blocked "Forbidden" 403
	request_body {
		max_size 1MB
	}
	handle /api/admin/* {
		reverse_proxy admin:8081
	}
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}
