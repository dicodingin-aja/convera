# Salin ke deploy/.env di VPS lalu isi. File .env tidak ikut ke git.

# Domain (DNS A record keduanya harus sudah mengarah ke IP VPS sebelum `docker compose up`).
APP_DOMAIN=app.contoh.id
API_DOMAIN=api.contoh.id
ADMIN_DOMAIN=admin.contoh.id
# Opsional: batasi akses admin ke IP tertentu (pisahkan spasi), mis. "203.0.113.5 198.51.100.0/24".
# ADMIN_ALLOW_IPS=
# Domain induk dengan titik di depan, agar app.* bisa membaca cookie CSRF dari api.*.
COOKIE_DOMAIN=.contoh.id

# Password PostgreSQL. Pakai hex agar aman di URL:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Kunci enkripsi token Meta (AES-256, base64):  openssl rand -base64 32
# SIMPAN SALINANNYA DI TEMPAT AMAN (password manager). Hilang = token tersimpan tidak bisa dibaca.
ENCRYPTION_KEY=

# Token antar-layanan untuk sesi WhatsApp Web (mode QR):  openssl rand -hex 24
QR_SERVICE_TOKEN=

# Versi Graph API yang masih didukung Meta (cek dokumentasi Meta), mis. v23.0
GRAPH_API_VERSION=

# Email transaksional (verifikasi, reset password, pengingat langganan/token). Tanpa SMTP_HOST email TIDAK terkirim
# (hanya tercetak di log). Siapkan SPF, DKIM, dan DMARC untuk domain pengirim agar tidak masuk spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Convera <no-reply@contoh.id>
