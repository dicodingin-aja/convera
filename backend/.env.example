# Salin ke backend/.env lalu isi. File .env tidak ikut ke git.
#
# Format: postgres://USER:PASSWORD@HOST:PORT/NAMA_DB?sslmode=disable
# Karakter khusus di password (@ : / # ?) harus di-encode, mis. @ -> %40
DATABASE_URL=postgres://postgres:ISI_PASSWORD@localhost:5432/db_convera?sslmode=disable

# Kunci AES-256 (base64, 32 byte) untuk mengenkripsi token Meta dan app secret.
# Buat dengan: go run ./cmd/genkey
# JANGAN hilang atau diganti setelah ada data: token yang sudah tersimpan jadi tidak bisa dibaca.
ENCRYPTION_KEY=

# Versi Graph API untuk Meta Conversions API. Sengaja tanpa default: cek versi yang masih
# didukung di dokumentasi Meta (mis. v23.0) lalu isi di sini. Wajib untuk worker.
GRAPH_API_VERSION=

# --- Opsional ---
# API_ADDR=:8080
# UPLOAD_DIR=./data/uploads          # folder privat bukti transfer (API customer menulis, API admin membaca)
# ADMIN_ADDR=:8081                   # API Convera Admin (go run ./cmd/admin)
# GRAPH_BASE_URL=https://graph.facebook.com
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# COOKIE_SECURE=true                 # wajib true di produksi (HTTPS)
# COOKIE_DOMAIN=.convera.id          # produksi: agar app.convera.id bisa membaca csrf_token dari api.convera.id
# WEBHOOK_BASE=https://api.convera.id/webhook

# Email transaksional (verifikasi, reset password, pengingat). Tanpa SMTP_HOST email hanya dicetak ke log
# (mode pengembangan, tautan berisi token ikut tercetak). Produksi: isi semua dan siapkan SPF/DKIM/DMARC.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Convera <no-reply@contoh.id>
# APP_URL=https://app.contoh.id       # dipakai untuk tautan di email

# Layanan sesi WhatsApp Web (mode QR, binary cmd/waqr). Kosong = mode QR belum tersedia.
# API: QR_SERVICE_URL (alamat waqr) + QR_SERVICE_TOKEN. waqr: DATABASE_URL, QR_SERVICE_TOKEN (sama, min. 16 karakter),
# CONVERA_API_URL (alamat API ini), QR_SERVICE_ADDR (default 127.0.0.1:8090). waqr TIDAK boleh diekspos ke internet.
# Aktifkan juga fitur 'qr' di admin (Integrasi/feature flag) agar pelanggan bisa memilih mode ini.
# QR_DEVICE_NAME=Convera   # nama di WhatsApp > Perangkat tertaut (penautan baru saja)
# QR_SERVICE_URL=http://127.0.0.1:8090
# QR_SERVICE_TOKEN=
